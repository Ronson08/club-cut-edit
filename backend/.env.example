# ClubCut Edit Environment Configuration

# Application
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Default: Zero-overhead SQLite with WAL mode & FTS5 full-text search
DATABASE_URL=sqlite:///./data/clubcut.db
# Production PostgreSQL opt-in (uncomment to switch):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clubcut

# Storage & Uploads
MEDIA_DIR=./data/media
MAX_UPLOAD_SIZE_MB=2048

# Speech-to-Text (faster-whisper)
# Models: tiny, base, small, medium, large-v3 (tiny/base recommended for fast CPU)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Cloud BYOK (Optional fallback if user prefers cloud over local)
OPENAI_API_KEY=

# Groq Cloud (Free Tier Llama 3.3 70B & Llama 3.1 8B for fast speaker separation)
# Get a free key in 30 seconds at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

